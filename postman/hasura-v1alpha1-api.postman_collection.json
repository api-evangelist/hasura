                    "key": "Accept",
                    "value": "text/plain"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"opts\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"clean_output\": \"<boolean>\",\n  \"source\": \"<string>\"\n}",
