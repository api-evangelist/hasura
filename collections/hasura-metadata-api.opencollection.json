{
  "opencollection": "1.0.0",
  "info": {
    "name": "Hasura Engine HTTP APIs Graphql Metadata API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-hasura-admin-secret",
      "value": "{{x-hasura-admin-secret}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Metadata",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Manage Hasura metadata",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://my-graphql-engine.example.com/v1/metadata",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Single endpoint for all metadata operations such as tracking tables,\ncreating relationships, managing permissions, remote schemas, and\nactions. The request body specifies the metadata `type` (operation)\nand `args`.\n"
        }
      ]
    }
  ],
  "bundled": true
}