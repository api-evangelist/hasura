{
  "opencollection": "1.0.0",
  "info": {
    "name": "Hasura Engine HTTP APIs Graphql Query API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-hasura-admin-secret",
      "value": "{{x-hasura-admin-secret}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Query",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Execute schema/run_sql and other schema-level operations",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://my-graphql-engine.example.com/v2/query",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Schema API used to run SQL, manage event triggers, and perform other\ndatabase-schema operations. Replaces the deprecated /v1/query endpoint\nfor Hasura v2 metadata format.\n"
        }
      ]
    }
  ],
  "bundled": true
}